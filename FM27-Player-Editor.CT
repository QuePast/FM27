><VariableType>Byte</VariableType><Address>fm27Player+15D</Address></CheatEntry><CheatEntry><ID>128</ID><Description>"WBR"</Description><VariableType>Byte</VariableType><Address>fm27Player+15E</Address></CheatEntry></CheatEntries></CheatEntry><CheatEntry><ID>129</ID><Description>"--- Bulk edits (act on selected player) ---"</Description><Options moHideChildren="1" /><Color>00FF7F</Color><GroupHeader>1</GroupHeader><CheatEntries><CheatEntry>
          <ID>64</ID>
          <Description>"Bulk: set all attributes to a value"</Description>
          <Color>FF8000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local ok, p = pcall(getAddress, "fm27Player")
if not ok or not p or p == 0 then showMessage("Find a player first (Step 2).") return end
local v = inputQuery("Set all attributes", "Value for all 54 attributes (1-100):", "100")
if not v then return end
local n = tonumber(v)
if not n or n &lt; 1 or n &gt; 100 then showMessage("Value must be 1..100.") return end
for k = 0, 53 do writeBytes(p + 0x15F + k, n) end
showMessage(string.format("All 54 attributes set to %d.", n))
{$asm}

[DISABLE]
{$asm}</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>65</ID>
          <Description>"Bulk: set CA and PA"</Description>
          <Color>FF8000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local ok, p = pcall(getAddress, "fm27Player")
if not ok or not p or p == 0 then showMessage("Find a player first (Step 2).") return end
local caS = inputQuery("Set CA", "Current Ability (1-200):", tostring(readSmallInteger(p + 0x264) or 100))
if not caS then return end
local paS = inputQuery("Set PA", "Potential Ability (1-200):", tostring(readSmallInteger(p + 0x266) or 200))
if not paS then return end
local ca, pa = tonumber(caS), tonumber(paS)
if not ca or not pa or ca &lt; 1 or ca &gt; 200 or pa &lt; 1 or pa &gt; 200 then
  showMessage("CA and PA must be 1..200.") return
end
if ca &gt; pa then showMessage("CA cannot exceed PA.") return end
writeSmallInteger(p + 0x264, ca)
writeSmallInteger(p + 0x266, pa)
showMessage(string.format("Set CA=%d PA=%d.", ca, pa))
{$asm}

[DISABLE]
{$asm}</AssemblerScript>
        </CheatEntry>
      </CheatEntries></CheatEntry></CheatEntries>
    </CheatEntry>
